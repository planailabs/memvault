+        {
+            Ok(output) if output.status.success() => {}
+            Ok(output) => {
+                bail!(
+                    "Failed to re-sign the binary with codesign after finalizing the assets: {}",
+                    String::from_utf8_lossy(&output.stderr)
+                );
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                // codesign not available — try rcodesign (cross-platform ad-hoc signing)
+                let output = tokio::process::Command::new("rcodesign")
+                    .arg("sign")
+                    .arg(path)
+                    .output()
+                    .await
+                    .context("Neither `codesign` nor `rcodesign` found — cannot ad-hoc re-sign MachO binary. \
