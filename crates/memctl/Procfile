# Multi-node memvault development cluster.
#
# Uses separate CARGO_TARGET_DIR per node to avoid build lock conflicts.
# dx serve with @client/@server separates features:
#   @client: --no-default-features --features web (WASM only, no mio)
#   @server: uses defaults (daemon feature, full native stack)
#
# Prerequisites:
#   cd memvault/crates/memctl   (this directory)
#   overmind start              (or foreman start)

node_a: env CARGO_TARGET_DIR=../../target/node_a MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.a MEMVAULT_API_PORT=8401 dx serve --port 8080 @client --platform web --no-default-features --features web @server --platform server | tee /tmp/memvault-node-a.log
node_b: env CARGO_TARGET_DIR=../../target/node_b MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.b MEMVAULT_API_PORT=8402 dx serve --port 8090 @client --platform web --no-default-features --features web @server --platform server | tee /tmp/memvault-node-b.log
