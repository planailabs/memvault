# Multi-node memvault development cluster.
#
# Each node gets its own data dir, API port, and P2P listen address.
# The swarm + web UI + API all run together via Commands::Daemon.

node_a: env MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.a MEMVAULT_API_PORT=8401 cargo run -p memctl --features daemon -- daemon --listen /ip4/127.0.0.1/tcp/9001 | tee /tmp/memvault-node-a.log
node_b: env MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.b MEMVAULT_API_PORT=8402 cargo run -p memctl --features daemon -- daemon --listen /ip4/127.0.0.1/tcp/9002 --bootstrap /ip4/127.0.0.1/tcp/9001 | tee /tmp/memvault-node-b.log
