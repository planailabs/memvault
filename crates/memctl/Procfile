# Multi-node memvault development cluster with hot-reload.
#
# Uses separate CARGO_TARGET_DIR per node to avoid build lock conflicts.
# dx serve uses @client/@server to split features:
#   @client: --no-default-features --features web (WASM, no tokio/mio)
#   @server: default features including daemon (native, full stack)
#
# Prerequisites:
#   cd memvault/crates/memctl   (this directory)
#   overmind start              (or foreman start)
#
# For a single node:
#   MEMVAULT_API_PORT=8401 dx serve --port 8080 @client --no-default-features --features web @server

node_a: env CARGO_TARGET_DIR=../../target/node_a MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.a MEMVAULT_API_PORT=8401 dx serve --port 8080 @client --no-default-features --features web @server | tee /tmp/memvault-node-a.log
node_b: env CARGO_TARGET_DIR=../../target/node_b MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.b MEMVAULT_API_PORT=8402 dx serve --port 8090 @client --no-default-features --features web @server | tee /tmp/memvault-node-b.log
