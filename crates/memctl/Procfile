# Multi-node memvault development cluster.
#
# Uses dx serve from the memvault-web crate (which handles the server-dev
# WASM step correctly). memctl daemon mode is used for standalone/production.
#
# For production builds with embedded assets:
#   dx build --package memctl --embed @client --no-default-features --features web @server
#
# Prerequisites:
#   cd memvault/crates/memctl   (this directory)
#   overmind start              (or foreman start)

# Dev mode: use memvault-web's dx serve for web UI with hot-reload.
# The web UI connects to the memvault store directly (no daemon needed).
node_a: env MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.a CARGO_TARGET_DIR=../../target/node_a dx serve --package memvault-web --port 8080 | tee /tmp/memvault-node-a.log
node_b: env MEMVAULT_DATA_DIR=$HOME/.local/share/memvault.b CARGO_TARGET_DIR=../../target/node_b dx serve --package memvault-web --port 8090 | tee /tmp/memvault-node-b.log
